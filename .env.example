# コピーして .env にする:  cp .env.example .env
# ---- 共通 ----
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data

# ---- LLM(Claude API)----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---- ワーカー ----
# dummy: GPU なしで配管を確認する疑似プロバイダ / hunyuan3d: 実モデル(フェーズ0 以降)
SHAPE_PROVIDER=dummy
TEXTURE_PROVIDER=dummy
RIG_PROVIDER=dummy
RENDERER=dummy
VRAM_BUDGET_MB=11000

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:8000
